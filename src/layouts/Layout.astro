---
import { Font } from "astro:assets";
import NoteCatag from '../components/NoteCatag.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>study thing</title>
		<Font cssVariable="--font-pixel32" />
	</head>
	<body>
		<div class="layout-wrapper">
			<nav id="navbar">
				<h2>study thing</h2>
				<div>
					<a href="/">notes</a>
					<div style="padding-left: 20px;">
						<NoteCatag 
							subject="biology"
							topic={["chapter 9", "9.2 heart"]}
						/>
					</div>
					<br>
					<a href="/bagpack">bag packer</a>
				</div>
			</nav>
			<main id="content">
				<slot />
			</main>
		</div>
		
	</body>
</html>

<style>
	html,
	body {
		padding: 0;
		margin: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
		font-family: var(--font-pixel32);
	}

	#navbar {
		height: 100vh;
		background-color:#ffbce3;
		padding: 20px;
		box-sizing: border-box;
	}
	#content {
		box-sizing: border-box;
		height: 100vh;
		overflow-y:auto;
		margin-top: 50px;
		padding-left: 15%;
		padding-right: 15%;
	}

	#content :global(a) {
		color: #ea349e;
		text-decoration-line: none;
	}
	.layout-wrapper {
		display: grid;
		grid-template-columns: 300px 1fr;
		min-height: 100vh;
	}
</style>
